# ATI Motors Robotics Runbook Assistant - Environment Configuration
# Duplicate this file to .env and configure values for your environment.

# Application Settings
ENVIRONMENT=development
DEBUG=True
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (PostgreSQL)
# For local host running against Docker DB on localhost:
DATABASE_URL=postgresql://runbook_user:runbook_pass@localhost:5432/runbooks_db
# For Docker Compose internal networking, this becomes:
# DATABASE_URL=postgresql://runbook_user:runbook_pass@db:5432/runbooks_db

POSTGRES_USER=runbook_user
POSTGRES_PASSWORD=runbook_pass
POSTGRES_DB=runbooks_db
POSTGRES_PORT=5432

# Admin API Key for protected ingestion/management endpoints
ADMIN_API_KEY=ati_admin_dev_secret_change_in_prod

# Semantic Search / pgvector (Phase 4 / Future Extension)
ENABLE_PGVECTOR=false
EMBEDDING_MODEL=text-embedding-3-small

# Notion API Sync (Future Extension - no credentials needed for local CSV/MD imports)
NOTION_API_TOKEN=
NOTION_DATABASE_ID=

# Zendesk Apps Framework (Phase 5 Extension)
ZENDESK_SHARED_SECRET=
